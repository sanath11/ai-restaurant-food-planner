<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dining Intelligence • AI Restaurant Planner</title>
  <style>
    :root {
      /* Distinctive Palette: Warm, Appetizing, Sophisticated */
      --primary: #D84315;        /* Terra Cotta - warmth, appetite */
      --primary-dark: #BF360C;
      --primary-light: #FF6E40;
      --secondary: #558B2F;      /* Olive - fresh, organic */
      --secondary-dark: #33691E;
      --accent: #FFA726;         /* Amber - energy, discovery */
      --accent-light: #FFB74D;
      
      /* Semantic Colors */
      --success: #66BB6A;
      --warning: #FFA726;
      --error: #EF5350;
      --info: #42A5F5;
      
      /* Neutrals with warmth */
      --surface: #FFFAF5;        /* Cream - warmth without yellow */
      --surface-elevated: #FFFFFF;
      --surface-overlay: rgba(216, 67, 21, 0.04);
      --border: #E8DDD3;
      --border-focus: var(--primary);
      
      /* Text hierarchy */
      --text-primary: #3E2723;   /* Dark brown - readable, warm */
      --text-secondary: #6D4C41;
      --text-tertiary: #8D6E63;
      --text-inverse: #FFFFFF;
      
      /* Spacing scale */
      --spacing-xs: 4px;
      --spacing-sm: 8px;
      --spacing-md: 16px;
      --spacing-lg: 24px;
      --spacing-xl: 32px;
      --spacing-2xl: 48px;
      
      /* Border radius scale */
      --radius-sm: 6px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --radius-full: 9999px;
      
      /* Shadows */
      --shadow-sm: 0 1px 3px rgba(62, 39, 35, 0.08), 0 1px 2px rgba(62, 39, 35, 0.06);
      --shadow-md: 0 4px 6px rgba(62, 39, 35, 0.08), 0 2px 4px rgba(62, 39, 35, 0.06);
      --shadow-lg: 0 10px 15px rgba(62, 39, 35, 0.1), 0 4px 6px rgba(62, 39, 35, 0.08);
      --shadow-xl: 0 20px 25px rgba(62, 39, 35, 0.12), 0 10px 10px rgba(62, 39, 35, 0.08);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      max-width: 1600px;
      margin: 0 auto;
      padding: 0;
      background: var(--surface);
      color: var(--text-primary);
      line-height: 1.6;
      font-size: 15px;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    
    /* Container */
    .container {
      padding: var(--spacing-lg) var(--spacing-xl);
      max-width: 1600px;
      margin: 0 auto;
    }
    
    @media (max-width: 768px) {
      .container {
        padding: var(--spacing-md);
      }
    }

    /* Header - Distinctive Brand Identity */
    .header {
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
      padding: var(--spacing-2xl) var(--spacing-xl);
      margin-bottom: var(--spacing-2xl);
      position: relative;
      overflow: hidden;
    }
    
    .header::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -10%;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
      border-radius: 50%;
    }
    
    .header-content {
      position: relative;
      z-index: 1;
      max-width: 1600px;
      margin: 0 auto;
    }
    
    .header h1 {
      font-size: 2.5rem;
      font-weight: 700;
      color: var(--text-inverse);
      margin: 0 0 var(--spacing-sm) 0;
      letter-spacing: -0.02em;
      display: flex;
      align-items: center;
      gap: var(--spacing-md);
    }
    
    .brand-icon {
      font-size: 3rem;
      filter: drop-shadow(0 2px 8px rgba(0,0,0,0.2));
    }
    
    .header-subtitle {
      font-size: 1.125rem;
      color: rgba(255,255,255,0.9);
      font-weight: 400;
      max-width: 600px;
    }
    
    .header-meta {
      margin-top: var(--spacing-md);
      display: flex;
      gap: var(--spacing-lg);
      flex-wrap: wrap;
    }
    
    .header-stat {
      display: flex;
      align-items: center;
      gap: var(--spacing-xs);
      color: rgba(255,255,255,0.85);
      font-size: 0.875rem;
    }
    
    .header-stat-icon {
      opacity: 0.7;
    }

    /* Search & Filters - Interactive Discovery */
    .search-section {
      background: var(--surface-elevated);
      padding: var(--spacing-xl);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-md);
      margin-bottom: var(--spacing-xl);
      border: 1px solid var(--border);
    }
    
    .search-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: var(--spacing-lg);
    }
    
    .search-title {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
    }
    
    .search-controls {
      display: grid;
      grid-template-columns: 2fr 2fr auto;
      gap: var(--spacing-md);
      margin-bottom: var(--spacing-lg);
    }
    
    @media (max-width: 768px) {
      .search-controls {
        grid-template-columns: 1fr;
      }
    }
    
    .input-group {
      position: relative;
    }
    
    .input-label {
      display: block;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-secondary);
      margin-bottom: var(--spacing-xs);
    }
    
    .search-input {
      width: 100%;
      padding: 12px var(--spacing-md);
      border: 2px solid var(--border);
      border-radius: var(--radius-md);
      font-size: 0.9375rem;
      color: var(--text-primary);
      background: var(--surface);
      transition: all 0.2s ease;
    }
    
    .search-input:focus {
      outline: none;
      border-color: var(--primary);
      background: var(--surface-elevated);
      box-shadow: 0 0 0 3px rgba(216, 67, 21, 0.1);
    }
    
    .search-input::placeholder {
      color: var(--text-tertiary);
    }
    
    .search-btn {
      align-self: end;
      padding: 12px var(--spacing-xl);
      background: var(--primary);
      color: var(--text-inverse);
      border: none;
      border-radius: var(--radius-md);
      cursor: pointer;
      font-size: 0.9375rem;
      font-weight: 600;
      transition: all 0.2s ease;
      box-shadow: var(--shadow-sm);
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
    }
    
    .search-btn:hover {
      background: var(--primary-dark);
      box-shadow: var(--shadow-md);
      transform: translateY(-1px);
    }
    
    .search-btn:active {
      transform: translateY(0);
    }
    
    /* Filter Pills */
    .filter-section {
      display: flex;
      gap: var(--spacing-sm);
      flex-wrap: wrap;
      padding-top: var(--spacing-md);
      border-top: 1px solid var(--border);
    }
    
    .filter-label {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--text-secondary);
      display: flex;
      align-items: center;
    }
    
    .filter-pill {
      padding: 6px 14px;
      border-radius: var(--radius-full);
      border: 2px solid var(--border);
      background: var(--surface);
      color: var(--text-primary);
      font-size: 0.8125rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s ease;
      user-select: none;
    }
    
    .filter-pill:hover {
      border-color: var(--primary);
      background: var(--surface-overlay);
    }
    
    .filter-pill.active {
      background: var(--primary);
      color: var(--text-inverse);
      border-color: var(--primary);
    }
    
    .filter-pill input[type="checkbox"] {
      display: none;
    }

    /* KPI Grid - Data Integrity & Context */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: var(--spacing-md);
      margin-bottom: var(--spacing-xl);
    }
    
    .kpi-card {
      background: var(--surface-elevated);
      padding: var(--spacing-lg);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--border);
      position: relative;
      overflow: hidden;
      transition: all 0.2s ease;
    }
    
    .kpi-card:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-2px);
    }
    
    .kpi-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 4px;
      height: 100%;
      background: var(--accent-color, var(--primary));
    }
    
    .kpi-card.restaurants { --accent-color: var(--primary); }
    .kpi-card.avg-rating { --accent-color: var(--accent); }
    .kpi-card.favorites { --accent-color: var(--secondary); }
    .kpi-card.weather { --accent-color: var(--info); }
    
    .kpi-header {
      display: flex;
      justify-content: space-between;
      align-items: start;
      margin-bottom: var(--spacing-md);
    }
    
    .kpi-label {
      font-size: 0.8125rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-secondary);
      font-weight: 700;
      line-height: 1.4;
    }
    
    .kpi-icon {
      font-size: 1.5rem;
      opacity: 0.3;
    }
    
    .kpi-value {
      font-size: 2.5rem;
      font-weight: 800;
      color: var(--text-primary);
      line-height: 1;
      margin-bottom: var(--spacing-xs);
      font-variant-numeric: tabular-nums;
    }
    
    .kpi-meta {
      font-size: 0.8125rem;
      color: var(--text-tertiary);
      display: flex;
      align-items: center;
      gap: var(--spacing-xs);
    }
    
    .kpi-change {
      display: inline-flex;
      align-items: center;
      gap: 3px;
      padding: 2px 6px;
      border-radius: var(--radius-sm);
      font-size: 0.75rem;
      font-weight: 600;
      margin-top: var(--spacing-xs);
    }
    
    .kpi-change.positive {
      background: rgba(102, 187, 106, 0.1);
      color: var(--success);
    }
    
    .kpi-change.negative {
      background: rgba(239, 83, 80, 0.1);
      color: var(--error);
    }
    
    .kpi-freshness {
      font-size: 0.6875rem;
      color: var(--text-tertiary);
      margin-top: var(--spacing-sm);
      padding-top: var(--spacing-sm);
      border-top: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: var(--spacing-xs);
    }

    /* Restaurant Cards - Rich Data Presentation */
    .results-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: var(--spacing-lg);
    }
    
    .results-title {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--text-primary);
    }
    
    .sort-controls {
      display: flex;
      gap: var(--spacing-sm);
      align-items: center;
    }
    
    .sort-label {
      font-size: 0.8125rem;
      color: var(--text-secondary);
      font-weight: 500;
    }
    
    .sort-select {
      padding: 8px 12px;
      border: 2px solid var(--border);
      border-radius: var(--radius-md);
      font-size: 0.8125rem;
      color: var(--text-primary);
      background: var(--surface-elevated);
      cursor: pointer;
      font-weight: 500;
    }
    
    .restaurants-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
      gap: var(--spacing-lg);
    }
    
    @media (max-width: 768px) {
      .restaurants-grid {
        grid-template-columns: 1fr;
      }
    }
    
    .restaurant-card {
      background: var(--surface-elevated);
      padding: 0;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--border);
      transition: all 0.2s ease;
      overflow: hidden;
      cursor: pointer;
    }
    
    .restaurant-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lg);
      border-color: var(--primary);
    }
    
    .restaurant-image-placeholder {
      height: 160px;
      background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3rem;
      position: relative;
      overflow: hidden;
    }
    
    .restaurant-image-placeholder::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -30%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
    }
    
    .restaurant-content {
      padding: var(--spacing-lg);
    }
    
    .restaurant-header {
      display: flex;
      justify-content: space-between;
      align-items: start;
      gap: var(--spacing-md);
      margin-bottom: var(--spacing-md);
    }
    
    .restaurant-name {
      font-size: 1.125rem;
      font-weight: 700;
      color: var(--text-primary);
      margin: 0;
      line-height: 1.3;
    }
    
    .restaurant-actions {
      display: flex;
      gap: var(--spacing-xs);
    }
    
    .action-btn {
      width: 32px;
      height: 32px;
      border-radius: var(--radius-md);
      border: 1px solid var(--border);
      background: var(--surface);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
      transition: all 0.2s ease;
    }
    
    .action-btn:hover {
      background: var(--primary);
      border-color: var(--primary);
      color: var(--text-inverse);
    }
    
    .rating-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 6px 10px;
      background: linear-gradient(135deg, var(--accent-light), var(--accent));
      color: var(--text-primary);
      border-radius: var(--radius-md);
      font-size: 0.875rem;
      font-weight: 700;
      box-shadow: var(--shadow-sm);
      margin-bottom: var(--spacing-sm);
    }
    
    .categories {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-xs);
      margin: var(--spacing-md) 0;
    }
    
    .category-tag {
      padding: 4px 10px;
      background: var(--surface-overlay);
      color: var(--text-secondary);
      border-radius: var(--radius-full);
      font-size: 0.75rem;
      font-weight: 500;
      border: 1px solid var(--border);
    }
    
    .restaurant-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--spacing-md);
      padding-top: var(--spacing-md);
      border-top: 1px solid var(--border);
    }
    
    .stat-item {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    
    .stat-label {
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-tertiary);
      font-weight: 600;
    }
    
    .stat-value {
      font-size: 0.9375rem;
      font-weight: 700;
      color: var(--text-primary);
    }
    
    .price-indicator {
      color: var(--secondary);
      font-weight: 700;
    }
    
    .restaurant-location {
      display: flex;
      align-items: start;
      gap: var(--spacing-xs);
      margin-top: var(--spacing-md);
      padding: var(--spacing-sm);
      background: var(--surface-overlay);
      border-radius: var(--radius-md);
      font-size: 0.8125rem;
      color: var(--text-secondary);
      line-height: 1.4;
    }

    /* Empty State - Engaging & Helpful */
    .empty-state {
      background: var(--surface-elevated);
      padding: var(--spacing-2xl);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
      text-align: center;
      border: 2px dashed var(--border);
      margin: var(--spacing-xl) 0;
    }
    
    .empty-state-icon {
      font-size: 4rem;
      margin-bottom: var(--spacing-lg);
      filter: grayscale(1);
      opacity: 0.3;
      animation: float 3s ease-in-out infinite;
    }
    
    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }
    
    .empty-state-title {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: var(--spacing-sm);
    }
    
    .empty-state-message {
      font-size: 0.9375rem;
      color: var(--text-secondary);
      max-width: 400px;
      margin: 0 auto var(--spacing-lg);
      line-height: 1.6;
    }
    
    .empty-state-cta {
      display: inline-flex;
      align-items: center;
      gap: var(--spacing-sm);
      padding: 10px var(--spacing-lg);
      background: var(--primary);
      color: var(--text-inverse);
      border-radius: var(--radius-md);
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s ease;
      cursor: pointer;
      border: none;
      font-size: 0.9375rem;
    }
    
    .empty-state-cta:hover {
      background: var(--primary-dark);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    /* Loading - Smooth & Branded */
    .loading {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: var(--spacing-2xl);
      gap: var(--spacing-lg);
    }
    
    .spinner {
      position: relative;
      width: 56px;
      height: 56px;
    }
    
    .spinner::before,
    .spinner::after {
      content: '';
      position: absolute;
      border-radius: 50%;
    }
    
    .spinner::before {
      width: 56px;
      height: 56px;
      border: 3px solid var(--border);
    }
    
    .spinner::after {
      width: 56px;
      height: 56px;
      border: 3px solid transparent;
      border-top-color: var(--primary);
      border-right-color: var(--primary);
      animation: spin 0.8s cubic-bezier(0.5, 0, 0.5, 1) infinite;
    }
    
    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    
    .loading-text {
      font-size: 0.9375rem;
      color: var(--text-secondary);
      font-weight: 500;
      animation: pulse 1.5s ease-in-out infinite;
    }
    
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }
    
    /* Error State */
    .error-state {
      background: rgba(239, 83, 80, 0.05);
      border: 2px solid rgba(239, 83, 80, 0.2);
      padding: var(--spacing-xl);
      border-radius: var(--radius-lg);
      text-align: center;
    }
    
    .error-icon {
      font-size: 3rem;
      margin-bottom: var(--spacing-md);
    }
    
    .error-title {
      font-size: 1.125rem;
      font-weight: 600;
      color: var(--error);
      margin-bottom: var(--spacing-sm);
    }
    
    .error-message {
      font-size: 0.9375rem;
      color: var(--text-secondary);
    }
  </style>
</head>
<body>
  <!-- Header -->
  <div class="header">
    <div class="header-content">
      <h1>
        <span class="brand-icon">🍴</span>
        <span>Dining Intelligence</span>
      </h1>
      <div class="header-subtitle">AI-powered restaurant discovery with transparent scoring and semantic search</div>
      <div class="header-meta">
        <div class="header-stat">
          <span class="header-stat-icon">✨</span>
          <span>6-Factor Scoring</span>
        </div>
        <div class="header-stat">
          <span class="header-stat-icon">🧠</span>
          <span>Semantic Search</span>
        </div>
        <div class="header-stat">
          <span class="header-stat-icon">🎯</span>
          <span>Explainable AI</span>
        </div>
      </div>
    </div>
  </div>
  
  <div class="container">

    <!-- Search Section -->
    <div class="search-section">
      <div class="search-header">
        <h2 class="search-title">
          <span>🔍</span>
          <span>Discover Restaurants</span>
        </h2>
      </div>
      
      <form id="searchForm">
        <div class="search-controls">
          <div class="input-group">
            <label class="input-label" for="location">Location</label>
            <input 
              type="text" 
              id="location" 
              name="location" 
              class="search-input" 
              placeholder="e.g., Chicago, IL"
              value="Chicago, IL"
              required
            >
          </div>
          
          <div class="input-group">
            <label class="input-label" for="term">Cuisine or Keyword</label>
            <input 
              type="text" 
              id="term" 
              name="term" 
              class="search-input" 
              placeholder="e.g., pizza, sushi, romantic"
            >
          </div>
          
          <button type="submit" class="search-btn">
            <span>🔍</span>
            <span>Search</span>
          </button>
        </div>
        
        <div class="filter-section">
          <span class="filter-label">Quick Filters:</span>
          <label class="filter-pill">
            <input type="checkbox" id="filter-open" value="open_now">
            <span>🕑 Open Now</span>
          </label>
          <label class="filter-pill">
            <input type="checkbox" id="filter-price1" value="1">
            <span>$ Budget</span>
          </label>
          <label class="filter-pill">
            <input type="checkbox" id="filter-price2" value="2">
            <span>$ Moderate</span>
          </label>
          <label class="filter-pill">
            <input type="checkbox" id="filter-price3" value="3">
            <span>$$ Upscale</span>
          </label>
          <label class="filter-pill">
            <input type="checkbox" id="filter-rating" value="4">
            <span>⭐ 4+ Stars</span>
          </label>
        </div>
      </form>
    </div>

    <!-- KPI Grid -->
    <div class="kpi-grid">
      <div class="kpi-card restaurants">
        <div class="kpi-header">
          <div class="kpi-label">Restaurants Found</div>
          <div class="kpi-icon">🏪</div>
        </div>
        <div class="kpi-value" id="kpi-total">0</div>
        <div class="kpi-meta">
          <span id="kpi-location-meta">In current search</span>
        </div>
        <div class="kpi-freshness">
          <span>🔄</span>
          <span id="kpi-timestamp">Last updated: --</span>
        </div>
      </div>
      
      <div class="kpi-card avg-rating">
        <div class="kpi-header">
          <div class="kpi-label">Average Quality</div>
          <div class="kpi-icon">⭐</div>
        </div>
        <div class="kpi-value" id="kpi-rating">--</div>
        <div class="kpi-meta">
          <span>Out of 5.0 stars</span>
        </div>
        <div id="kpi-rating-trend"></div>
        <div class="kpi-freshness">
          <span>📈</span>
          <span>Yelp ratings</span>
        </div>
      </div>
      
      <div class="kpi-card favorites">
        <div class="kpi-header">
          <div class="kpi-label">Price Range</div>
          <div class="kpi-icon">💵</div>
        </div>
        <div class="kpi-value" id="kpi-price">--</div>
        <div class="kpi-meta">
          <span id="kpi-price-meta">Average cost level</span>
        </div>
        <div class="kpi-freshness">
          <span>🎯</span>
          <span>$ to $$ scale</span>
        </div>
      </div>
      
      <div class="kpi-card weather">
        <div class="kpi-header">
          <div class="kpi-label">Top Category</div>
          <div class="kpi-icon">🍽️</div>
        </div>
        <div class="kpi-value" id="kpi-category">--</div>
        <div class="kpi-meta">
          <span id="kpi-category-count">Most common cuisine</span>
        </div>
        <div class="kpi-freshness">
          <span>📋</span>
          <span>From search results</span>
        </div>
      </div>
    </div>

    <!-- Results Section -->
    <div id="results">
      <div class="empty-state">
        <div class="empty-state-icon">🍴</div>
        <h3 class="empty-state-title">Ready to Discover Amazing Restaurants?</h3>
        <p class="empty-state-message">Enter a location and start exploring curated dining experiences powered by AI</p>
        <button class="empty-state-cta" onclick="document.getElementById('location').focus()">
          <span>🔍</span>
          <span>Start Searching</span>
        </button>
      </div>
    </div>
  </div>

  <script>
    const searchForm = document.getElementById('searchForm');
    const resultsDiv = document.getElementById('results');
    let currentResults = [];

    // Filter pill interactivity
    document.querySelectorAll('.filter-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        const checkbox = pill.querySelector('input[type="checkbox"]');
        checkbox.checked = !checkbox.checked;
        pill.classList.toggle('active', checkbox.checked);
      });
    });

    searchForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const location = document.getElementById('location').value;
      const term = document.getElementById('term').value;
      
      // Show loading
      resultsDiv.innerHTML = `
        <div class="loading">
          <div class="spinner"></div>
          <div class="loading-text">Discovering restaurants in ${location}...</div>
        </div>
      `;
      
      try {
        const params = new URLSearchParams({ location });
        if (term) params.append('term', term);
        
        // Add active filters
        if (document.getElementById('filter-open').checked) {
          params.append('open_now', 'true');
        }
        
        const activePrices = [];
        if (document.getElementById('filter-price1').checked) activePrices.push('1');
        if (document.getElementById('filter-price2').checked) activePrices.push('2');
        if (document.getElementById('filter-price3').checked) activePrices.push('3');
        if (activePrices.length > 0) {
          params.append('price', activePrices.join(','));
        }
        
        const response = await fetch(`/api/search?${params}`);
        const data = await response.json();
        
        if (data.error) {
          resultsDiv.innerHTML = `
            <div class="error-state">
              <div class="error-icon">⚠️</div>
              <h3 class="error-title">Search Failed</h3>
              <p class="error-message">${data.error}</p>
            </div>
          `;
          return;
        }
        
        currentResults = data.restaurants || [];
        
        // Update KPIs with context
        updateKPIs(currentResults, location);
        
        // Render restaurants
        renderRestaurants(currentResults);
        
      } catch (error) {
        resultsDiv.innerHTML = `
          <div class="error-state">
            <div class="error-icon">❌</div>
            <h3 class="error-title">Connection Error</h3>
            <p class="error-message">${error.message}</p>
          </div>
        `;
      }
    });
    
    function updateKPIs(restaurants, location) {
      const timestamp = new Date().toLocaleTimeString('en-US', { 
        hour: '2-digit', 
        minute: '2-digit' 
      });
      
      // Total count
      document.getElementById('kpi-total').textContent = restaurants.length;
      document.getElementById('kpi-location-meta').textContent = `Found in ${location}`;
      document.getElementById('kpi-timestamp').textContent = `Last updated: ${timestamp}`;
      
      // Average rating
      if (restaurants.length > 0) {
        const avgRating = restaurants.reduce((sum, r) => sum + (r.rating || 0), 0) / restaurants.length;
        document.getElementById('kpi-rating').textContent = avgRating.toFixed(1);
        
        const highRated = restaurants.filter(r => r.rating >= 4.0).length;
        const pct = ((highRated / restaurants.length) * 100).toFixed(0);
        document.getElementById('kpi-rating-trend').innerHTML = `
          <div class="kpi-change positive">
            <span>↑</span>
            <span>${pct}% rated 4.0+</span>
          </div>
        `;
      } else {
        document.getElementById('kpi-rating').textContent = '--';
        document.getElementById('kpi-rating-trend').innerHTML = '';
      }
      
      // Average price
      const priceMap = {'
        const avgPrice = prices.reduce((a, b) => a + b, 0) / prices.length;
        const priceLabel = Object.keys(priceMap).find(k => priceMap[k] === Math.round(avgPrice)) || '--';
        document.getElementById('kpi-price').textContent = priceLabel;
        document.getElementById('kpi-price-meta').textContent = `${prices.length} have pricing data`;
      } else {
        document.getElementById('kpi-price').textContent = '--';
        document.getElementById('kpi-price-meta').textContent = 'No pricing data';
      }
      
      // Top category
      const categoryCount = {};
      restaurants.forEach(r => {
        (r.categories || []).forEach(cat => {
          const title = cat.title || cat;
          categoryCount[title] = (categoryCount[title] || 0) + 1;
        });
      });
      
      const topCategory = Object.entries(categoryCount)
        .sort((a, b) => b[1] - a[1])[0];
      
      if (topCategory) {
        document.getElementById('kpi-category').textContent = topCategory[0];
        document.getElementById('kpi-category-count').textContent = `${topCategory[1]} restaurants`;
      } else {
        document.getElementById('kpi-category').textContent = '--';
        document.getElementById('kpi-category-count').textContent = 'No categories';
      }
    }
    
    function renderRestaurants(restaurants) {
      if (restaurants.length === 0) {
        resultsDiv.innerHTML = `
          <div class="empty-state">
            <div class="empty-state-icon">🔍</div>
            <h3 class="empty-state-title">No Restaurants Found</h3>
            <p class="empty-state-message">Try adjusting your search location or removing filters</p>
          </div>
        `;
        return;
      }
      
      resultsDiv.innerHTML = `
        <div class="results-header">
          <h2 class="results-title">Found ${restaurants.length} Restaurant${restaurants.length !== 1 ? 's' : ''}</h2>
        </div>
        <div class="restaurants-grid">
          ${restaurants.map(r => renderRestaurantCard(r)).join('')}
        </div>
      `;
    }
    
    function renderRestaurantCard(r) {
      const categories = (r.categories || []).slice(0, 3);
      const hasLocation = r.location && r.location.address1;
      
      return `
        <div class="restaurant-card">
          <div class="restaurant-image-placeholder">
            <span style="font-size: 4rem; filter: drop-shadow(0 2px 8px rgba(0,0,0,0.2));">
              ${getCuisineEmoji(categories)}
            </span>
          </div>
          
          <div class="restaurant-content">
            <div class="restaurant-header">
              <div>
                <h3 class="restaurant-name">${r.name}</h3>
                ${r.rating ? `
                  <div class="rating-badge">
                    <span>⭐</span>
                    <span>${r.rating.toFixed(1)}</span>
                  </div>
                ` : ''}
              </div>
              <div class="restaurant-actions">
                <button class="action-btn" title="Save to favorites" onclick="alert('Favorites feature coming soon!')">
                  <span>♡</span>
                </button>
                <button class="action-btn" title="Share" onclick="alert('Share feature coming soon!')">
                  <span>↗</span>
                </button>
              </div>
            </div>
            
            ${categories.length > 0 ? `
              <div class="categories">
                ${categories.map(c => 
                  `<span class="category-tag">${c.title || c}</span>`
                ).join('')}
              </div>
            ` : ''}
            
            <div class="restaurant-stats">
              <div class="stat-item">
                <div class="stat-label">Price</div>
                <div class="stat-value price-indicator">${r.price || 'N/A'}</div>
              </div>
              <div class="stat-item">
                <div class="stat-label">Reviews</div>
                <div class="stat-value">${formatNumber(r.review_count || 0)}</div>
              </div>
              <div class="stat-item">
                <div class="stat-label">Distance</div>
                <div class="stat-value">${r.distance ? (r.distance / 1609.34).toFixed(1) + ' mi' : 'N/A'}</div>
              </div>
            </div>
            
            ${hasLocation ? `
              <div class="restaurant-location">
                <span>📍</span>
                <span>${r.location.address1}${r.location.city ? ', ' + r.location.city : ''}</span>
              </div>
            ` : ''}
          </div>
        </div>
      `;
    }
    
    function getCuisineEmoji(categories) {
      const categoryStr = categories.map(c => (c.title || c).toLowerCase()).join(' ');
      
      if (categoryStr.includes('pizza')) return '🍕';
      if (categoryStr.includes('sushi') || categoryStr.includes('japanese')) return '🍱';
      if (categoryStr.includes('burger')) return '🍔';
      if (categoryStr.includes('mexican') || categoryStr.includes('taco')) return '🌮';
      if (categoryStr.includes('italian') || categoryStr.includes('pasta')) return '🍝';
      if (categoryStr.includes('chinese')) return '🥡';
      if (categoryStr.includes('indian')) return '🍛';
      if (categoryStr.includes('thai')) return '🍜';
      if (categoryStr.includes('coffee') || categoryStr.includes('cafe')) return '☕';
      if (categoryStr.includes('dessert') || categoryStr.includes('bakery')) return '🧁';
      if (categoryStr.includes('bar') || categoryStr.includes('pub')) return '🍺';
      
      return '🍽️';
    }
    
    function formatNumber(num) {
      if (num >= 1000) {
        return (num / 1000).toFixed(1) + 'k';
      }
      return num.toString();
    }
  </script>
</body>
